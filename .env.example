# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# JWT_SECRET: Secret key used to sign session and meeting access tokens.
JWT_SECRET="replace-with-a-long-random-secret"

# Optional LiveKit SFU configuration for large-scale 100-500 participant rooms
# LIVEKIT_URL="wss://your-project.livekit.cloud"
# LIVEKIT_API_KEY="MY_LIVEKIT_API_KEY"
# LIVEKIT_API_SECRET="MY_LIVEKIT_API_SECRET"

# Optional Razorpay Gateway keys for Indian INR payments
# RAZORPAY_KEY_ID="rzp_test_..."
# RAZORPAY_KEY_SECRET="..."

# Optional TURN server credentials for strict corporate NAT traversal
# TURN_URL="turn:your-turn-server:3478"
# TURN_USERNAME=""
# TURN_CREDENTIAL=""
